@page "/"
@implements IDisposable
@using System.Globalization

<PageTitle>Our Way Home ♡</PageTitle>

<div class="home-shell">
    <div class="sky-stars" aria-hidden="true">
        @for (int i = 0; i < 34; i++)
        {
            <span class="sky-star" style="@StarStyle(i)">✦</span>
        }
    </div>

    <main class="home-card">
        <h1>Our Way Home <span class="pink-heart">♥</span></h1>
        <p class="subtitle">Every day brings us a little closer, my darling.</p>

        <div class="landscape" role="img" aria-label="A cozy cabin beneath the moon, surrounded by mountains, pine trees and a lake">
            <svg viewBox="0 0 900 320" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                <defs>
                    <linearGradient id="night" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#141738" />
                        <stop offset="1" stop-color="#3e426e" />
                    </linearGradient>
                    <linearGradient id="lake" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="#7186a7" />
                        <stop offset="1" stop-color="#414872" />
                    </linearGradient>
                    <radialGradient id="moon-halo">
                        <stop offset="0" stop-color="#fff4c8" stop-opacity=".5" />
                        <stop offset="1" stop-color="#fff4c8" stop-opacity="0" />
                    </radialGradient>
                </defs>
                <rect width="900" height="320" fill="url(#night)" />
                <circle cx="710" cy="64" r="72" fill="url(#moon-halo)" />
                <circle cx="710" cy="64" r="26" fill="#fff4d7" />
                <g fill="#f8f0ff" opacity=".95">
                    <circle cx="94" cy="46" r="2"/><circle cx="204" cy="84" r="1.5"/>
                    <circle cx="361" cy="49" r="2"/><circle cx="525" cy="74" r="1.6"/>
                    <circle cx="619" cy="24" r="1.8"/><circle cx="802" cy="110" r="2"/>
                    <circle cx="860" cy="39" r="1.5"/><circle cx="453" cy="27" r="1.5"/>
                </g>
                <path d="M0 191 L108 103 L174 152 L290 70 L432 191 L548 104 L642 165 L775 96 L900 195 L900 320 L0 320Z" fill="#555a84" />
                <path d="M0 207 L158 136 L253 192 L382 133 L503 216 L623 150 L727 211 L838 143 L900 184 L900 320 L0 320Z" fill="#343a65" />
                <path d="M0 229 Q190 208 343 227 Q496 207 653 231 Q802 218 900 231 L900 320 L0 320Z" fill="#242b4a" />
                <path d="M0 259 Q245 240 451 258 T900 261 L900 320 L0 320Z" fill="url(#lake)" />
                <path d="M0 292 Q268 271 418 295 Q618 274 900 295" fill="none" stroke="#c5d6e8" stroke-width="3" opacity=".32" />
                <path d="M460 320 Q427 287 460 259 Q474 243 468 231" fill="none" stroke="#f4cda5" stroke-width="24" opacity=".85" />
                <path d="M460 320 Q427 287 460 259 Q474 243 468 231" fill="none" stroke="#fff0bc" stroke-width="6" opacity=".54" />
                
                <!-- Pine trees -->
                <g fill="#1b2940">
                    <!-- Left small tree -->
                        <path d="M97 264 L97 244 L68 244
                                 L90 217 L79 217 L104 181
                                 L129 217 L118 217 L140 244
                                 L111 244 L111 264 Z" />

                    <!-- Left large tree -->
                        <path d="M155 270 L155 248 L116 248
                                 L144 221 L127 221 L166 173
                                 L205 221 L188 221 L216 248
                                 L177 248 L177 270 Z" />

                    <!-- Right large tree -->
                        <path d="M747 270 L747 245 L709 245
                                 L739 216 L720 216 L758 166
                                 L796 216 L777 216 L807 245
                                 L769 245 L769 270 Z" />

                    <!-- Right small tree -->
                        <path d="M830 273 L830 251 L806 251
                                 L823 227 L812 227 L838 195
                                 L864 227 L853 227 L870 251
                                 L846 251 L846 273 Z" />
                </g>

                <rect x="360" y="195" width="142" height="75" rx="4" fill="#69495a" />
                <path d="M346 202 L431 142 L519 202Z" fill="#342d46" />
                <path d="M355 202 L431 151 L509 202" fill="none" stroke="#ad8191" stroke-width="7" stroke-linecap="round" />
                <rect x="382" y="213" width="39" height="35" rx="3" fill="#ffe2a0" />
                <rect x="438" y="217" width="40" height="53" rx="3" fill="#422e42" />
                <rect x="446" y="227" width="24" height="43" rx="2" fill="#f8c77b" />
                <path d="M402 213 V248 M382 230 H421" stroke="#835d66" stroke-width="4" />
                <rect x="473" y="154" width="14" height="36" fill="#4b394e" />
                <path d="M478 147 Q459 134 467 120" stroke="#d9dcff" stroke-width="5" fill="none" stroke-linecap="round" opacity=".45" />
                <g fill="#f8d39a" opacity=".65">
                    <ellipse cx="403" cy="257" rx="55" ry="11"/>
                    <ellipse cx="459" cy="276" rx="23" ry="5"/>
                </g>
            </svg>
        </div>

        @if (remaining == TimeSpan.Zero)
        {
            <p class="countdown-heading">YOU'RE FINALLY HOME ♥</p>
            <p class="arrived-message">The wait is over. Our next chapter begins.</p>
        }
        else
        {
            <p class="countdown-heading">UNTIL WE'RE HOME TOGETHER</p>
        }

        <section class="time-grid" aria-label="Time until homecoming">
            <div class="time-cell"><strong>@remaining.Days</strong><span>Days</span></div>
            <div class="time-cell"><strong>@remaining.Hours.ToString("00")</strong><span>Hours</span></div>
            <div class="time-cell"><strong>@remaining.Minutes.ToString("00")</strong><span>Minutes</span></div>
            <div class="time-cell"><strong>@remaining.Seconds.ToString("00")</strong><span>Seconds</span></div>
        </section>
        <p class="arrival">✈ March 3, 2027 · 8:55 AM · Erfurt, Germany</p>

        <section class="journey">
            <div class="journey-heading">
                <span>Our journey <small>Since April 14, 2026</small></span>
                <strong>@progress.ToString("0.0", CultureInfo.InvariantCulture)%</strong>
            </div>
            <div class="progress-track" role="progressbar" aria-label="Journey to homecoming"
                 aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressAria">
                <div class="progress-fill" style="@ProgressStyle"></div>
            </div>
            <p class="journey-footnote">Every day brings us closer to home. ♡</p>
        </section>

        <div class="anniversary-message">
            @if (isAnniversary)
            {
                <p>✨ Happy @monthsTogether-month anniversary, my love! ✨</p>
            }
            else
            {
                <p>I love you for all eternity ✨</p>
            }
        </div>

        <button class="sparkle-button" @onclick="Celebrate">✦ Make it sparkle ✦</button>
        @if (showSparkles)
        {
            <div class="sparkle-layer" @key="sparkleVersion" aria-hidden="true">
                @for (int i = 0; i < 30; i++)
                {
                    <span class="burst-star" style="@BurstStyle(i)">✦</span>
                }
            </div>
        }
    </main>
</div>

@code {
    private static readonly DateTimeOffset arrivalDate = new(2027, 3, 3, 8, 55, 0, TimeSpan.FromHours(1));
    private static readonly DateTimeOffset journeyStart = new(2026, 4, 14, 0, 0, 0, TimeSpan.FromHours(2));
    private static readonly TimeZoneInfo germanTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin");

    private TimeSpan remaining;
    private double progress;
    private bool isAnniversary;
    private int monthsTogether;
    private bool showSparkles;
    private int sparkleVersion;
    private DateOnly? lastCelebratedOn;
    private System.Threading.Timer? countdownTimer;
    private string ProgressStyle => $"width: {progress.ToString("0.##", CultureInfo.InvariantCulture)}%";
    private string ProgressAria => progress.ToString("0", CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        UpdateCountdown();
        countdownTimer = new System.Threading.Timer(
            state => { _ = InvokeAsync(() => { UpdateCountdown(); StateHasChanged(); }); },
            null,
            TimeSpan.FromSeconds(1),
            TimeSpan.FromSeconds(1));
    }

    private void UpdateCountdown()
    {
        DateTimeOffset now = DateTimeOffset.UtcNow;
        TimeSpan difference = arrivalDate - now;
        remaining = difference > TimeSpan.Zero ? difference : TimeSpan.Zero;

        double totalSeconds = (arrivalDate - journeyStart).TotalSeconds;
        progress = Math.Clamp((now - journeyStart).TotalSeconds / totalSeconds * 100, 0, 100);

        DateTimeOffset germanNow = TimeZoneInfo.ConvertTime(now, germanTimeZone);
        isAnniversary = germanNow.Day == 14;
        monthsTogether = Math.Max(0,
            (germanNow.Year - 2026) * 12 + germanNow.Month - 4 - (germanNow.Day < 14 ? 1 : 0));

        DateOnly germanDate = DateOnly.FromDateTime(germanNow.Date);
        if (isAnniversary && lastCelebratedOn != germanDate)
        {
            lastCelebratedOn = germanDate;
            Celebrate();
        }
    }

    private void Celebrate()
    {
        showSparkles = true;
        sparkleVersion++; // Recreates the sparkle elements so CSS animations replay.
    }

    private static string StarStyle(int i) =>
        $"--x:{(i * 37 + 13) % 98}%;--y:{(i * 19 + 7) % 72}%;--delay:{(i % 11) * .27:0.00}s;";

    private static string BurstStyle(int i) =>
        $"--x:{(i * 43 + 7) % 96}%;--y:{(i * 29 + 8) % 91}%;--delay:{(i % 8) * .09:0.00}s;";

    public void Dispose() => countdownTimer?.Dispose();
}
